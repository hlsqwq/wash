# 本地开发配置模板。
# 复制为 application-local.yml（该文件已被 .gitignore 排除），
# 或直接通过环境变量注入；不要把真实密码/密钥提交到 Git。
spring:
  datasource:
    url: jdbc:mysql://10.32.22.200:3306/wash?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: change-me-db-password
  jpa:
    properties:
      hibernate:
        format_sql: true

app:
  public-base-url: http://10.32.22.200:8080
  storage:
    endpoint: http://10.32.22.200:9000
    access-key: change-me-access-key
    secret-key: change-me-secret-key
    bucket: wash-model-images
    region: us-east-1
    auto-create-bucket: true
