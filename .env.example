# 后端本地运行环境变量模板（复制为 .env 或按需 export；.env 已被 .gitignore 排除）。
# 这里只能出现占位值，禁止写入任何真实密码或密钥。

# ---- 数据库 ----
# DB_URL=jdbc:mysql://<mysql-host>:3306/wash?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change-me-db-password

# ---- RustFS / S3 ----
RUSTFS_ENDPOINT=http://<rustfs-host>:9000
RUSTFS_ACCESS_KEY=change-me-access-key
RUSTFS_SECRET_KEY=change-me-secret-key
RUSTFS_BUCKET=wash-model-images
RUSTFS_REGION=us-east-1
RUSTFS_AUTO_CREATE_BUCKET=true

# ---- 应用 ----
SERVER_PORT=8080
# 对外可访问的后端地址；为空时按当前请求 Host 生成图片地址。
APP_PUBLIC_BASE_URL=
# 启动时导入 seed/models.json 中的四个真实模型（幂等）。
APP_SEED_ENABLED=true
